<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041.0 = 再生中の曲の取得など、Windows の新しい API を使うため -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Islandock</AssemblyName>
    <RootNamespace>Islandock</RootNamespace>
    <!-- リリースのタグ（v1.1.0 など）と合わせる。アプリ内のアップデート確認がこの番号と比べる -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

</Project>
