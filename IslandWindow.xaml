<Window x:Class="Islandock.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Islandock Island"
        Width="640" Height="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- 丸いボタン（タブなど） -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F7" />
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 枠のないアイコンだけのボタン（再生・一時停止など） -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 黒背景用の細いスクロールバー -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#55FFFFFF" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 画面のいちばん上の端にマウスが来たことを検知する、ほぼ透明な帯 -->
        <Border x:Name="HoverStrip" Width="320" Height="8" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#01000000" />

      <!-- アイランド・2つ目の丸（同時に2つ動いているとき）・マイク/カメラのランプを横に並べる -->
      <!-- ふだんは画面の上に隠しておき、マウスが上の端に来たときだけ下りてくる -->
      <StackPanel x:Name="IslandRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="0,6,0,0" Opacity="0">
        <StackPanel.RenderTransform>
            <TranslateTransform x:Name="IslandRowShift" Y="-60" />
        </StackPanel.RenderTransform>

        <!-- アイランド本体（黒いカプセル。大きさはコードでアニメーションさせる） -->
        <Border x:Name="Island"
                Width="220" Height="36"
                VerticalAlignment="Top"
                Background="Black"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" />
            </Border.Effect>

            <Grid>
                <!-- ===== 小さいとき ===== -->
                <Grid x:Name="CompactView">
                    <!-- 何も動いていないとき: 時刻と日付 -->
                    <Grid x:Name="CompactIdle" Margin="16,0">
                        <TextBlock x:Name="CompactTime" Text="12:00" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock x:Name="CompactRight" Text="11月7日 (土)" Foreground="#A1A1A6" FontSize="12.5"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- 音楽の再生中: 左にアルバムアート、右に再生/一時停止と波形 -->
                    <Grid x:Name="CompactMedia" Margin="7,0,14,0" Visibility="Collapsed">
                        <Border x:Name="CompactArt" Width="24" Height="24" CornerRadius="6" Background="#2C2C2E"
                                HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True" />
                        <TextBlock x:Name="CompactTitle" Foreground="#D1D1D6" FontSize="12" Margin="34,0,64,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="CompactPlayButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,28,0" Click="OnMediaPlayPause" ToolTip="再生 / 一時停止" />
                        <StackPanel x:Name="CompactWave" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Height="18" />
                    </Grid>

                    <!-- タイマー / ストップウォッチ: 左にアイコン、右に残り時間 -->
                    <Grid x:Name="CompactTimer" Margin="14,0,16,0" Visibility="Collapsed">
                        <TextBlock x:Name="CompactTimerIcon" Text="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" Foreground="#FF9F0A" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock x:Name="CompactTimerText" Text="5:00" Foreground="#FF9F0A" FontSize="14.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>

                <!-- ===== お知らせ（充電・消音・音量・イヤホン・タイマー終了など） ===== -->
                <Grid x:Name="AlertView" Margin="16,0,14,0" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="AlertLeft" VerticalAlignment="Center" Focusable="False" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                        <TextBlock x:Name="AlertTitle" Foreground="White" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AlertSub" Foreground="#A1A1A6" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <ContentControl x:Name="AlertCenter" Grid.Column="1" VerticalAlignment="Center" Margin="12,0"
                                    Focusable="False" Visibility="Collapsed" />
                    <ContentControl x:Name="AlertRight" Grid.Column="2" VerticalAlignment="Center" Focusable="False" />
                </Grid>

                <!-- ===== 大きいとき ===== -->
                <Grid x:Name="ExpandedView" Width="520" Height="400" Margin="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed" Opacity="0">
                    <Grid Margin="22,18,22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 上段: 大きな時計とタブ -->
                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock x:Name="BigTime" Text="12:00" Foreground="White" FontSize="40"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Light" />
                                <TextBlock x:Name="BigDate" Text="2026年11月7日 土曜日" Foreground="#A1A1A6"
                                           FontSize="13" Margin="2,-2,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                                <Button x:Name="MediaTab" Content="再生中" Style="{StaticResource PillButton}"
                                        Click="OnMediaTab" Margin="0,0,5,0" Padding="10,5" />
                                <Button x:Name="TimerTab" Content="タイマー" Style="{StaticResource PillButton}"
                                        Click="OnTimerTab" Margin="0,0,5,0" Padding="10,5" />
                                <Button x:Name="CalendarTab" Content="カレンダー" Style="{StaticResource PillButton}"
                                        Click="OnCalendarTab" Margin="0,0,5,0" Padding="10,5" />
                                <Button x:Name="AirDropTab" Style="{StaticResource PillButton}" Click="OnAirDropTab"
                                        Padding="9,5" ToolTip="ファイル共有（近距離共有）"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Content="&#xE72D;" />
                            </StackPanel>
                        </DockPanel>

                        <!-- 下段: 再生中の音楽 -->
                        <Grid x:Name="MediaView" Grid.Row="1" Visibility="Collapsed">
                            <StackPanel x:Name="MediaContent" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <Border x:Name="MediaArt" Width="104" Height="104" CornerRadius="16" Background="#2C2C2E"
                                            DockPanel.Dock="Left" ClipToBounds="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.5" />
                                        </Border.Effect>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top"
                                                Margin="0,8,0,0">
                                        <StackPanel x:Name="MediaWave" Orientation="Horizontal" Height="24" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="18,0,12,0">
                                        <TextBlock x:Name="MediaTitle" Foreground="White" FontSize="19" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MediaArtist" Foreground="#A1A1A6" FontSize="14" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MediaApp" Foreground="#636366" FontSize="11.5" Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- 再生位置（クリック・ドラッグで移動できる） -->
                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MediaElapsed" Text="0:00" Foreground="#8E8E93" FontSize="11.5"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="MediaProgressHost" Grid.Column="1" />
                                    <TextBlock x:Name="MediaRemaining" Grid.Column="2" Text="-0:00" Foreground="#8E8E93"
                                               FontSize="11.5" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>

                                <!-- 前へ / 再生・一時停止 / 次へ -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                                            FontSize="24" Click="OnMediaPrev" />
                                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                            FontSize="34" Margin="34,0" Click="OnMediaPlayPause" />
                                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                                            FontSize="24" Click="OnMediaNext" />
                                </StackPanel>

                                <!-- 音量 -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE993;"
                                            FontSize="15" Click="OnToggleMute" HorizontalAlignment="Left" ToolTip="消音" />
                                    <Border x:Name="VolumeHost" Grid.Column="1" />
                                    <TextBlock Grid.Column="2" Text="&#xE995;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Foreground="#8E8E93" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <!-- 何も再生していないとき -->
                            <StackPanel x:Name="MediaEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40"
                                           Foreground="#48484A" HorizontalAlignment="Center" />
                                <TextBlock Text="再生中の曲はありません" Foreground="#F2F2F7" FontSize="14"
                                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Text="Spotify・YouTube（ブラウザ）・メディア プレーヤーなどで再生すると、ここに表示されます"
                                           Foreground="#8E8E93" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="360" />
                                <!-- BGM（設定した YouTube の再生リスト）を開くボタン -->
                                <StackPanel x:Name="BgmButtons" Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,14,0,0">
                                    <Button x:Name="BgmPlayButton" Content="▶  BGMを再生" Style="{StaticResource PillButton}"
                                            Padding="16,7" Click="OnPlayBgm" ToolTip="設定した YouTube の再生リストを開いて再生" />
                                    <Button x:Name="BgmEditButton" Content="変更" Style="{StaticResource PillButton}"
                                            Padding="12,7" Margin="6,0,0,0" Click="OnEditBgm"
                                            ToolTip="BGM に使う再生リストを変える" />
                                </StackPanel>

                                <!-- 再生リストの URL を入力する欄 -->
                                <StackPanel x:Name="BgmEditor" Visibility="Collapsed" Margin="0,14,0,0" Width="400">
                                    <Border Background="#1C1C1E" CornerRadius="16" Padding="12,4,4,4">
                                        <DockPanel>
                                            <Button Content="保存" DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                                                    Background="#0A84FF" Foreground="White" Click="OnSaveBgm" />
                                            <Button Content="やめる" DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                                                    Margin="0,0,4,0" Click="OnCancelBgm" />
                                            <Grid>
                                                <TextBlock x:Name="BgmPlaceholder" Text="YouTube の再生リストの URL を貼り付け"
                                                           Foreground="#636366" FontSize="12.5" VerticalAlignment="Center"
                                                           IsHitTestVisible="False" />
                                                <TextBox x:Name="BgmUrlBox" Background="Transparent" BorderThickness="0"
                                                         Foreground="White" CaretBrush="White" FontSize="12.5"
                                                         VerticalContentAlignment="Center" Height="28"
                                                         KeyDown="OnBgmUrlKeyDown" TextChanged="OnBgmUrlChanged" />
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock x:Name="BgmEditorHint" Foreground="#8E8E93" FontSize="11.5" Margin="4,6,0,0"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Text="例: https://www.youtube.com/playlist?list=PL…（空にして保存すると解除）" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 下段: タイマーとストップウォッチ -->
                        <Grid x:Name="TimerView" Grid.Row="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- タイマー -->
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="タイマー" Foreground="#8E8E93" FontSize="12" />
                                <TextBlock x:Name="TimerText" Text="5:00" Foreground="White" FontSize="44" FontWeight="Light"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,2,0,2" />
                                <Border x:Name="TimerProgressHost" Margin="0,0,0,12" />
                                <WrapPanel x:Name="TimerPresets" Margin="0,0,0,6" />
                                <StackPanel x:Name="TimerAdjust" Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="−1分" Style="{StaticResource PillButton}" Margin="0,0,5,0" Tag="-60" Click="OnTimerAdjust" />
                                    <Button Content="+1分" Style="{StaticResource PillButton}" Margin="0,0,5,0" Tag="60" Click="OnTimerAdjust" />
                                    <Button Content="+5分" Style="{StaticResource PillButton}" Tag="300" Click="OnTimerAdjust" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TimerStartButton" Content="開始" Style="{StaticResource PillButton}"
                                            Background="#FF9F0A" Foreground="Black" Padding="18,7" FontWeight="SemiBold"
                                            Margin="0,0,8,0" Click="OnTimerStartPause" />
                                    <Button Content="リセット" Style="{StaticResource PillButton}" Padding="16,7" Click="OnTimerReset" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#2C2C2E" />

                            <!-- ストップウォッチ -->
                            <Grid Grid.Column="2" Margin="18,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="ストップウォッチ" Foreground="#8E8E93" FontSize="12" />
                                <TextBlock x:Name="StopwatchText" Grid.Row="1" Text="0:00.0" Foreground="White" FontSize="44"
                                           FontWeight="Light" FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,2,0,10" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="StopwatchStartButton" Content="開始" Style="{StaticResource PillButton}"
                                            Background="#30D158" Foreground="Black" Padding="18,7" FontWeight="SemiBold"
                                            Margin="0,0,8,0" Click="OnStopwatchStartStop" />
                                    <Button x:Name="StopwatchLapButton" Content="ラップ" Style="{StaticResource PillButton}"
                                            Padding="16,7" Click="OnStopwatchLapReset" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="LapList" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- 下段: カレンダー -->
                        <Grid x:Name="CalendarView" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,0,6">
                                <TextBlock x:Name="MonthTitle" Text="2026年11月" Foreground="White" FontSize="16"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="‹" Style="{StaticResource PillButton}" Padding="11,1,11,3" FontSize="16"
                                            Click="OnPrevMonth" Margin="0,0,4,0" />
                                    <Button Content="今日" Style="{StaticResource PillButton}" Click="OnToday" Margin="0,0,4,0" />
                                    <Button Content="›" Style="{StaticResource PillButton}" Padding="11,1,11,3" FontSize="16"
                                            Click="OnNextMonth" />
                                </StackPanel>
                            </DockPanel>
                            <UniformGrid x:Name="WeekHeader" Grid.Row="1" Columns="7" Margin="0,0,0,2" />
                            <UniformGrid x:Name="DayGrid" Grid.Row="2" Columns="7" Rows="6" />
                        </Grid>

                        <!-- 下段: ファイル共有（Windows の近距離共有でファイルを送る） -->
                        <Grid x:Name="AirDropView" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ファイルを落とす場所 -->
                            <Border x:Name="AirDropZone" CornerRadius="22" BorderThickness="1.5"
                                    BorderBrush="#3A3A3C" Background="#141416" Cursor="Hand"
                                    MouseLeftButtonUp="OnAirDropPick">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="78" Height="78" HorizontalAlignment="Center">
                                        <Ellipse x:Name="AirDropRing" Stroke="#0A84FF" StrokeThickness="1.5" Opacity="0.35"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="AirDropRingScale" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="58" Height="58">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#40A9FF" Offset="0" />
                                                    <GradientStop Color="#0A64E0" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="AirDropTitle" Text="ファイル共有" Foreground="White" FontSize="17"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                                    <TextBlock x:Name="AirDropHint" Text="ファイルをここにドラッグ、またはクリックして選択"
                                               Foreground="#8E8E93" FontSize="12.5" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
                                </StackPanel>
                            </Border>

                            <!-- スマホから受け取る（QR コードを読み取ってもらう） -->
                            <Border x:Name="PhonePanel" CornerRadius="22" BorderThickness="1.5" BorderBrush="#0A84FF"
                                    Background="#0B1E36" Visibility="Collapsed">
                                <Grid Margin="22,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="White" CornerRadius="14" Padding="10" VerticalAlignment="Center">
                                        <Image x:Name="PhoneQr" Width="170" Height="170"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PhoneTitle" Text="スマホから受け取る" Foreground="White" FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Foreground="#A1A1A6" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   LineHeight="19">
                                            <Run Text="1. スマホを PC と同じ Wi-Fi につなぐ" /><LineBreak />
                                            <Run Text="2. カメラでこの QR コードを読み取る" /><LineBreak />
                                            <Run Text="3. 開いたページでファイルを選ぶ" />
                                        </TextBlock>
                                        <TextBlock x:Name="PhoneUrl" Foreground="#64A8FF" FontSize="11.5" Margin="0,10,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="PhoneState" Text="待機中…" Foreground="#30D158" FontSize="12.5"
                                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                        <Button Content="受信を止める" Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                                                Margin="0,12,0,0" Click="OnPhoneStop" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 受信の設定（近距離共有の状態） -->
                            <DockPanel Grid.Row="1" Margin="4,12,0,0" LastChildFill="False">
                                <Ellipse x:Name="AirDropStatusDot" Width="8" Height="8" Fill="#8E8E93"
                                         VerticalAlignment="Center" DockPanel.Dock="Left" />
                                <TextBlock x:Name="AirDropStatus" Text="受信: オフ" Foreground="#D1D1D6" FontSize="12.5"
                                           Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                <Button Content="設定" Style="{StaticResource PillButton}" DockPanel.Dock="Right"
                                        Click="OnAirDropSettings" ToolTip="近距離共有の設定を開く" />
                                <Button Content="受信したファイル" Style="{StaticResource PillButton}" DockPanel.Dock="Right"
                                        Margin="0,0,6,0" Click="OnAirDropOpenReceived" />
                                <Button x:Name="PhoneButton" Content="スマホから受け取る" Style="{StaticResource PillButton}"
                                        DockPanel.Dock="Right" Margin="0,0,6,0" Background="#0A84FF" Foreground="White"
                                        Click="OnPhoneStart" />
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 2つ目の動作中のもの（iPhone の「分割表示」の小さな丸） -->
        <Border x:Name="Bubble" Width="36" Height="36" CornerRadius="18" Background="Black" Margin="7,0,0,0"
                VerticalAlignment="Top" Visibility="Collapsed" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35" />
            </Border.Effect>
            <ContentControl x:Name="BubbleContent" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
        </Border>

        <!-- マイク（オレンジ）・カメラ（緑）を使用中のランプ -->
        <StackPanel x:Name="PrivacyDots" Margin="7,6,0,0" VerticalAlignment="Top" Visibility="Collapsed">
            <Ellipse x:Name="CameraDot" Width="7" Height="7" Fill="#30D158" Margin="0,0,0,4" Visibility="Collapsed" />
            <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" Visibility="Collapsed" />
        </StackPanel>
      </StackPanel>
    </Grid>
</Window>
